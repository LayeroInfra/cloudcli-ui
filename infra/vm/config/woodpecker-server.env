WOODPECKER_HOST=http://127.0.0.1:8000
WOODPECKER_SERVER_ADDR=127.0.0.1:8000
WOODPECKER_GRPC_ADDR=127.0.0.1:9000
WOODPECKER_OPEN=true
WOODPECKER_ADMIN=buildadmin
WOODPECKER_AGENT_SECRET=@WOODPECKER_AGENT_SECRET@
WOODPECKER_GITEA=true
WOODPECKER_GITEA_URL=http://127.0.0.1:3030
WOODPECKER_GITEA_CLIENT=@WOODPECKER_OAUTH_CLIENT_ID@
WOODPECKER_GITEA_SECRET=@WOODPECKER_OAUTH_CLIENT_SECRET@
WOODPECKER_DATABASE_DRIVER=sqlite3
WOODPECKER_DATABASE_DATASOURCE=@HOME@/.local/state/woodpecker/server.db
WOODPECKER_LOG_LEVEL=info
