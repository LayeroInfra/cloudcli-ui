#!/bin/bash
# Run `make <target>` of a Layero repo on WORKSPACE_OWNER's Mac through Woodpecker.
# The VM is too small for Layero's gates and corpora, so make never runs here.
#
#   workspace-trigger-make <core|cli> <target> [NAME=value ...] [--ref <branch>] [--title "…"]
#   workspace-trigger-make core check
#   workspace-trigger-make core ship DRY=1
#   workspace-trigger-make core check --ref fix/T-123   # a branch, e.g. of a worktree
#
# The Mac takes the current commit of /srv/Layero/<repo> straight from this VM
# (companion SSH key), so it needs no push first; uncommitted edits stay here.
# Targets and variables the Mac accepts: companion/bin/workspace-run-make.
set -euo pipefail

REPO="${1:-}"
TARGET="${2:-}"
if [ -z "$REPO" ] || [ -z "$TARGET" ]; then
  echo "usage: workspace-trigger-make <core|cli> <target> [NAME=value ...] [--ref <branch>] [--title \"…\"]" >&2
  exit 2
fi
shift 2
VARS=()
TITLE=""
REF=""
while [ $# -gt 0 ]; do
  case "$1" in
    --title) TITLE="${2:-}"; shift 2 ;;
    --ref) REF="${2:-}"; shift 2 ;;
    --owner) echo "workspace-trigger-make: --owner запрещён; owner только из WORKSPACE_OWNER" >&2; exit 2 ;;
    *=*) VARS+=("$1"); shift ;;
    *) echo "workspace-trigger-make: unexpected argument $1" >&2; exit 2 ;;
  esac
done

CHECKOUT="/srv/Layero/$REPO"
case "$REPO" in core|cli) ;; *) echo "repo must be core or cli" >&2; exit 2 ;; esac
[ -d "$CHECKOUT/.git" ] || { echo "no checkout $CHECKOUT" >&2; exit 1; }
if [ -n "$REF" ]; then
  # Worktrees share the repo's branches, so a worktree branch is named here.
  SHA="$(git -C "$CHECKOUT" rev-parse --verify --quiet "refs/heads/$REF^{commit}")" ||
    { echo "no branch $REF in $CHECKOUT" >&2; exit 1; }
else
  REF="$(git -C "$CHECKOUT" symbolic-ref --quiet --short HEAD)" ||
    { echo "$CHECKOUT: HEAD is detached — switch to a branch or pass --ref" >&2; exit 1; }
  SHA="$(git -C "$CHECKOUT" rev-parse HEAD)"
  if [ -n "$(git -C "$CHECKOUT" status --porcelain --untracked-files=no)" ]; then
    echo "⚠️  $CHECKOUT has uncommitted edits — the Mac runs only commit ${SHA:0:12}" >&2
  fi
fi

VARS_STR="${VARS[*]+${VARS[*]}}"
[ -n "$TITLE" ] || TITLE="make $TARGET${VARS_STR:+ $VARS_STR} ($REPO ${REF})"
exec "$HOME/.local/bin/workspace-trigger-build" --job make --title "$TITLE" \
  --var "WORKSPACE_MAKE_REPO=$REPO" \
  --var "WORKSPACE_MAKE_TARGET=$TARGET" \
  --var "WORKSPACE_MAKE_VARS=$VARS_STR" \
  --var "WORKSPACE_MAKE_REF=$REF" \
  --var "WORKSPACE_MAKE_SHA=$SHA"
