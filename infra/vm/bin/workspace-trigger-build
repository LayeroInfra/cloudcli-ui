#!/bin/bash
# Create a Woodpecker pipeline for WORKSPACE_OWNER from the environment only.
# Owner is never taken from argv — use the CloudUI API (session user) instead.
# WORKSPACE_JOB=checks|deploy|make|stage selects the Mac runner (default checks).
#
#   workspace-trigger-build --title "session rename"            # checks of /srv/Layero/cloud-cli HEAD
#   workspace-trigger-build --title "…" --ref feat/x            # checks of a branch (e.g. a worktree's)
#   workspace-trigger-build --title "…" --steps lint,typecheck  # only some steps
#   workspace-trigger-build --title "…" --wait                  # wait and print the result
#
# Before starting, it checks that WORKSPACE_OWNER's Mac (its Woodpecker agent)
# was in touch in the last 2 minutes; if not, it says so and exits 6 instead of
# leaving a run pending — `--queue` starts it anyway, to run when the Mac wakes.
#
# It prints the run number; `--wait` (or workspace-run-wait <number> later)
# waits for the run and prints its summary and the failure lines of failed
# steps, exiting 0 only when the run succeeded.
#
# Checks run on the Mac on the commit, not on the VM's working files:
# uncommitted edits are not checked (a warning says so).
set -euo pipefail
# shellcheck source=/dev/null
source "$HOME/.local/bin/workspace-owner-lib.sh"

export WOODPECKER_SERVER="${WOODPECKER_SERVER:-http://127.0.0.1:8000}"
export WOODPECKER_DISABLE_UPDATE_CHECK=true
TOKEN_FILE="${HOME}/.local/state/woodpecker/user.token"
if [ -z "${WOODPECKER_TOKEN:-}" ] && [ -f "$TOKEN_FILE" ]; then
  WOODPECKER_TOKEN=$(tr -d "\n" < "$TOKEN_FILE")
  export WOODPECKER_TOKEN
fi
if [ -z "${WOODPECKER_TOKEN:-}" ]; then
  echo "Нет WOODPECKER_TOKEN ($TOKEN_FILE)" >&2
  exit 1
fi

OWNER="$(normalize_workspace_owner "${WORKSPACE_OWNER:-}")"
TITLE="${WORKSPACE_BUILD_TITLE:-}"
JOB="$(printf '%s' "${WORKSPACE_JOB:-checks}" | tr '[:upper:]' '[:lower:]')"
REF=""
STEPS=""
WAIT=0
QUEUE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --title)
      TITLE="${2:-}"
      shift 2
      ;;
    --job)
      JOB="$(printf '%s' "${2:-}" | tr '[:upper:]' '[:lower:]')"
      shift 2
      ;;
    --ref)
      REF="${2:-}"
      shift 2
      ;;
    --steps)
      STEPS="${2:-}"
      shift 2
      ;;
    --wait)
      WAIT=1
      shift
      ;;
    --queue)
      QUEUE=1
      shift
      ;;
    --owner)
      echo "workspace-trigger-build: --owner убран; owner только из WORKSPACE_OWNER (сессия CloudUI)" >&2
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

if [ -z "$OWNER" ]; then
  echo "Нет WORKSPACE_OWNER — не могу создать пайплайн с label owner=…" >&2
  exit 1
fi

case "$JOB" in
  checks|deploy|make|stage) ;;
  *)
    echo "workspace-trigger-build: WORKSPACE_JOB must be checks, deploy, make or stage (got $JOB)" >&2
    exit 2
    ;;
esac

if [ -z "$TITLE" ]; then
  if [ "$JOB" = "deploy" ]; then
    TITLE="Deploy workspace-ui"
  elif [ "$JOB" = "stage" ]; then
    TITLE="Stage ${REF:-current branch}"
  else
    TITLE="Manual checks"
  fi
fi

TITLE="$(printf "%s" "$TITLE" | tr "\n\r\t" "   " | sed -E "s/  +/ /g; s/^ +//; s/ +$//" | cut -c1-80)"
BRANCH="${WOODPECKER_BRANCH:-main}"
ARGS=(pipeline create buildadmin/cloudcli-checks --branch "$BRANCH" \
  --var "WORKSPACE_OWNER=${OWNER}" \
  --var "WORKSPACE_JOB=${JOB}" \
  --var "WORKSPACE_BUILD_TITLE=${TITLE}")

# checks and stage run on one commit of the CloudUI checkout, which the Mac fetches from this VM.
if [ "$JOB" = checks ] || [ "$JOB" = stage ]; then
  CHECKOUT="${WORKSPACE_CHECKS_CHECKOUT:-/srv/Layero/cloud-cli}"
  if [ -n "$REF" ]; then
    SHA="$(git -C "$CHECKOUT" rev-parse --verify --quiet "refs/heads/$REF^{commit}")" ||
      { echo "no branch $REF in $CHECKOUT" >&2; exit 1; }
  else
    REF="$(git -C "$CHECKOUT" symbolic-ref --quiet --short HEAD)" ||
      { echo "$CHECKOUT: HEAD is detached — switch to a branch or pass --ref" >&2; exit 1; }
    SHA="$(git -C "$CHECKOUT" rev-parse HEAD)"
    if [ -n "$(git -C "$CHECKOUT" status --porcelain --untracked-files=no)" ]; then
      echo "⚠️  $CHECKOUT has uncommitted edits — the Mac runs only commit ${SHA:0:12}" >&2
    fi
  fi
  PREFIX=WORKSPACE_CHECKS
  [ "$JOB" = stage ] && PREFIX=WORKSPACE_STAGE
  ARGS+=(--var "${PREFIX}_REF=${REF}" --var "${PREFIX}_SHA=${SHA}")
  [ -n "$STEPS" ] && ARGS+=(--var "WORKSPACE_CHECKS_STEPS=${STEPS}")
  echo "$JOB: $REF @ ${SHA:0:12}" >&2
elif [ -n "$REF" ] || [ -n "$STEPS" ]; then
  echo "workspace-trigger-build: --ref/--steps are for checks and stage only" >&2
  exit 2
fi
# The remaining arguments (--var …) go to woodpecker-cli; --wait/--queue among them are ours.
PASS=()
for arg in "$@"; do
  case "$arg" in
    --wait) WAIT=1 ;;
    --queue) QUEUE=1 ;;
    *) PASS+=("$arg") ;;
  esac
done

# Is the owner's Mac there? Runners live only on the owners' Macs.
SEEN="$(curl -fsS -m 10 -H "Authorization: Bearer $WOODPECKER_TOKEN" "$WOODPECKER_SERVER/api/agents" 2>/dev/null |
  python3 -c '
import json, sys, time
owner = sys.argv[1]
try:
    agents = json.load(sys.stdin) or []
except ValueError:
    print("unknown"); sys.exit()
ages = [int(time.time()) - int(a.get("last_contact") or 0) for a in agents if (a.get("custom_labels") or {}).get("owner") == owner]
print(min(ages) if ages else "none")
' "$OWNER" || echo unknown)"
case "$SEEN" in
  unknown) echo "(could not ask Woodpecker whether the Mac of $OWNER is online)" >&2 ;;
  none|*[!0-9]*)
    echo "no Woodpecker agent for owner=$OWNER: that Mac never registered (companion/bin/install.sh there)" >&2
    [ "$QUEUE" = 1 ] || exit 6 ;;
  *)
    if [ "$SEEN" -gt 120 ]; then
      echo "the Mac of $OWNER is offline: its agent was last in touch $((SEEN / 60)) min ago" >&2
      echo "  wake it (or pass --queue to start the run anyway; it waits as pending until the Mac is back)" >&2
      [ "$QUEUE" = 1 ] || exit 6
    fi ;;
esac
OUT="$("$HOME/.local/bin/woodpecker-cli" "${ARGS[@]}" ${PASS[@]+"${PASS[@]}"})"
printf '%s\n' "$OUT"
NUMBER="$(printf '%s\n' "$OUT" | awk '$1 ~ /^[0-9]+$/ { print $1; exit }')"
if [ -z "$NUMBER" ]; then
  echo "workspace-trigger-build: could not read the run number from woodpecker-cli" >&2
  exit 1
fi
echo "run #$NUMBER — result: workspace-run-wait $NUMBER" >&2
[ "$WAIT" = 1 ] || exit 0
exec "$HOME/.local/bin/workspace-run-wait" "$NUMBER"
