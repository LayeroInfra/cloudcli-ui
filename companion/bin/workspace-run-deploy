#!/bin/bash
# Runs on this Mac inside a Woodpecker local step: builds origin/main of the
# UI and ships it to the workspace VM.
#
# The build happens in its own worktree (~/.cache/layero-workspace/ship), never
# in the developer's checkout, so a deploy does not switch their branch or
# touch their edits. The VM side (workspace-promote-release) serialises
# deploys, refuses an older commit, checks dependencies and rolls back a
# release whose smoke test fails.
#
# Only main ships. WORKSPACE_DEPLOY_REF may name another ref of origin, but its
# commit must already be on origin/main (WORKSPACE_DEPLOY_ALLOW_BRANCH=1 is the
# operator's way round). The commit must be green: when GitHub has no
# successful workspace/checks status for it (a merge commit never had a run of
# its own), the full checks run here first and a red one stops the deploy
# (exit 6). WORKSPACE_DEPLOY_SKIP_CHECKS=1 is the operator's emergency bypass.
#
# The VM switches only when no agent is mid-turn (A7): it waits up to
# WORKSPACE_DEPLOY_QUIET_WAIT seconds (default 900) and otherwise refuses
# (exit 7). WORKSPACE_DEPLOY_FORCE_BUSY=1 restarts regardless.
set -euo pipefail
JOB_LIB="$(cd "$(dirname "$0")" && pwd)/lib/workspace-job-env.sh"
[ -f "$JOB_LIB" ] || JOB_LIB="/Users/$(/usr/bin/id -un)/.local/share/cloudcli-companion/bin/lib/workspace-job-env.sh"
# shellcheck source=lib/workspace-job-env.sh
source "$JOB_LIB"
# shellcheck source=lib/workspace-checks-steps.sh
source "$(dirname "$JOB_LIB")/workspace-checks-steps.sh"

REF="${WORKSPACE_DEPLOY_REF:-origin/main}"
SHIP="${WORKSPACE_SHIP_DIR:-$HOME/.cache/layero-workspace/ship}"
SSH_CONFIG="${HOME}/.config/layero-workspace/ssh/config"
SSH_HOST="${WORKSPACE_DEPLOY_SSH_HOST:-layero-workspace}"
REMOTE_RELEASES='~/.local/share/cloudcli-releases'
ssh_vm() { ssh -F "$SSH_CONFIG" -o BatchMode=yes "$SSH_HOST" "$@"; }

echo "workspace-run-deploy owner=$JOB_OWNER checkout=$JOB_CHECKOUT ref=$REF"

git -C "$JOB_CHECKOUT" fetch -q origin
SHA="$(git -C "$JOB_CHECKOUT" rev-parse "$REF^{commit}")"
if [ "${WORKSPACE_DEPLOY_ALLOW_BRANCH:-0}" != 1 ] &&
  ! git -C "$JOB_CHECKOUT" merge-base --is-ancestor "$SHA" origin/main; then
  echo "refused: $REF ($SHA) is not on origin/main — only main ships (merge the PR first)" >&2
  exit 3
fi

if [ ! -e "$SHIP/.git" ]; then
  mkdir -p "$(dirname "$SHIP")"
  git -C "$JOB_CHECKOUT" worktree prune
  git -C "$JOB_CHECKOUT" worktree add --detach "$SHIP" "$SHA"
else
  git -C "$SHIP" checkout -q --detach --force "$SHA"
  git -C "$SHIP" clean -qfdx -e node_modules
fi
cd "$SHIP"
echo "building $(git log -1 --format='%h %s')"

# Reinstall only when the lockfile changed since the last deploy.
LOCK_HASH="$(shasum -a 256 package-lock.json | cut -d' ' -f1)"
if [ ! -d node_modules ] || [ "$(cat node_modules/.ship-lock-hash 2>/dev/null)" != "$LOCK_HASH" ]; then
  npm ci --no-audit --no-fund
  echo "$LOCK_HASH" > node_modules/.ship-lock-hash
fi
if [ "${WORKSPACE_DEPLOY_SKIP_CHECKS:-0}" = 1 ]; then
  echo "⚠️  WORKSPACE_DEPLOY_SKIP_CHECKS=1: shipping $SHA without checks"
elif check_status_is_green "$SHA"; then
  echo "checks: workspace/checks is green on GitHub for ${SHA:0:12}"
else
  echo "checks: no green workspace/checks for ${SHA:0:12} — running them before the build"
  export PATH="$SHIP/node_modules/.bin:$PATH"
  # build is left out: the deploy builds right below anyway.
  run_check_steps swift shell lint typecheck test-server test-client fake-agent
  print_check_summary "${SHA:0:12} (deploy)"
  if [ "$CHECK_FAILED" -ne 0 ]; then
    post_check_status "$SHA" failure "$CHECK_FAILED steps failed (deploy gate)"
    echo "refused: checks are red on $SHA; nothing shipped" >&2
    exit 6
  fi
  post_check_status "$SHA" success "${#CHECK_RESULTS[@]} steps passed (deploy gate)"
fi
npm run build

ASSET="$(grep -o 'assets/index-[^"]*\.js' dist/index.html | head -n1)"
if [ -z "$ASSET" ]; then
  echo "no index asset in dist/index.html" >&2
  exit 1
fi
printf '%s\n%s\n' "$SHA" "$ASSET" > SHIPPED_FROM

STAGE="workspace-ui.incoming-$SHA"
echo "==> rsync → $SSH_HOST:$REMOTE_RELEASES/$STAGE"
ssh_vm "mkdir -p $REMOTE_RELEASES/$STAGE"
rsync -a --delete -e "ssh -F $SSH_CONFIG -o BatchMode=yes" \
  dist dist-server package.json package-lock.json SHIPPED_FROM \
  "$SSH_HOST:$REMOTE_RELEASES/$STAGE/"

echo "==> promote $SHA"
status=0
PROMOTE_ARGS=("$SHA")
QUIET_WAIT="${WORKSPACE_DEPLOY_QUIET_WAIT:-}"
if [ -n "$QUIET_WAIT" ]; then
  [[ "$QUIET_WAIT" =~ ^[0-9]+$ ]] || { echo "WORKSPACE_DEPLOY_QUIET_WAIT must be seconds" >&2; exit 2; }
  PROMOTE_ARGS+=(--quiet-wait "$QUIET_WAIT")
fi
[ "${WORKSPACE_DEPLOY_FORCE_BUSY:-0}" = 1 ] && PROMOTE_ARGS+=(--force-busy)
IGNORE_SESSION="${WORKSPACE_DEPLOY_IGNORE_SESSION:-}"
if [ -n "$IGNORE_SESSION" ]; then
  [[ "$IGNORE_SESSION" =~ ^[A-Za-z0-9_.:-]+$ ]] || { echo "bad WORKSPACE_DEPLOY_IGNORE_SESSION" >&2; exit 2; }
  PROMOTE_ARGS+=(--ignore-session "$IGNORE_SESSION")
fi
ssh_vm "\$HOME/.local/bin/workspace-promote-release ${PROMOTE_ARGS[*]}" || status=$?
case "$status" in
  0) echo "shipped $ASSET ($SHA)" ;;
  3) echo "VM refused the release (see message above)" >&2 ;;
  4) echo "smoke test failed on the VM; the previous release is back" >&2 ;;
  5) echo "another deploy is running on the VM; try again later" >&2 ;;
  7) echo "not deployed: agents were mid-turn (or the live release cannot say); nothing changed — retry later, or WORKSPACE_DEPLOY_FORCE_BUSY=1" >&2 ;;
  *) echo "promote failed with exit $status" >&2 ;;
esac
exit "$status"
