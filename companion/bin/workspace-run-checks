#!/bin/bash
# Runs on this Mac inside a Woodpecker local step: the CloudUI checks against
# the checkout named in identity.json, as it is on disk (uncommitted edits too).
set -euo pipefail
# Installed copies live in ~/.local/bin, the library in the installed companion.
JOB_LIB="$(cd "$(dirname "$0")" && pwd)/lib/workspace-job-env.sh"
[ -f "$JOB_LIB" ] || JOB_LIB="/Users/$(/usr/bin/id -un)/.local/share/cloudcli-companion/bin/lib/workspace-job-env.sh"
# shellcheck source=lib/workspace-job-env.sh
source "$JOB_LIB"

cd "$JOB_CHECKOUT"
export PATH="${JOB_CHECKOUT}/node_modules/.bin:$PATH"
echo "workspace-run-checks owner=$JOB_OWNER checkout=$JOB_CHECKOUT commit=$(git rev-parse --short HEAD 2>/dev/null || echo '?')$(git diff --quiet 2>/dev/null || echo '+dirty')"
tsx --tsconfig server/tsconfig.json --test \
  server/modules/providers/tests/claude-sessions.test.ts \
  server/modules/providers/tests/claude-rate-limits.test.ts \
  server/modules/workspace-builds/tests/workspace-builds.test.ts
# sidebarAccount.test.tsx is left out: under the Mac agent it crashes vitest's
# worker pool (ERR_IPC_CHANNEL_CLOSED, runs #21 and #26) and fails the run.
vitest run --pool=forks --maxWorkers=1 --fileParallelism=false \
  src/modules/project-workspace/tests/workspaceConnectionIndicator.test.tsx \
  src/modules/project-workspace/tests/workspaceBuildsPanel.test.tsx
