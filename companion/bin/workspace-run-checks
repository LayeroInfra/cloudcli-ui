#!/bin/bash
# Runs on this Mac inside a Woodpecker local step: the full CloudUI checks on
# one commit, in a clean clone — never in the developer's checkout.
#
# Set by workspace-trigger-build on the VM (all optional):
#   WORKSPACE_CHECKS_REF    branch of /srv/Layero/cloud-cli on the VM (default: its HEAD branch)
#   WORKSPACE_CHECKS_SHA    commit to check (default: the tip of that branch)
#   WORKSPACE_CHECKS_STEPS  comma-separated subset of the steps (default: all), see
#                           lib/workspace-checks-steps.sh; "quick" picks a quick run's
#                           steps for the changes since WORKSPACE_CHECKS_BASE
#   WORKSPACE_CHECKS_BASE   commit a quick run compares with (the branch's merge-base with main)
#   WORKSPACE_CHECKS_THEN_STAGE  1: after a green full run, stage the same commit in this job
#                           (workspace-run-stage: build, stage on the VM, e2e, screenshots)
#
# The Builds button sends neither REF nor SHA: then the VM checkout's current
# branch and commit are checked. The commit comes straight from the VM over the
# companion SSH key, so it need not be pushed first; uncommitted edits on the
# VM are not checked.
#
# Every step runs even after one fails; the summary lists them all and the exit
# status is non-zero when any failed. When gh is signed in on this Mac and the
# commit is on GitHub, the result is posted as the commit status "workspace/checks"
# (a partial run with WORKSPACE_CHECKS_STEPS posts nothing: it is not the gate).
set -euo pipefail
JOB_LIB="$(cd "$(dirname "$0")" && pwd)/lib/workspace-job-env.sh"
[ -f "$JOB_LIB" ] || JOB_LIB="/Users/$(/usr/bin/id -un)/.local/share/cloudcli-companion/bin/lib/workspace-job-env.sh"
# shellcheck source=lib/workspace-job-env.sh
source "$JOB_LIB"
LIB_DIR="$(dirname "$JOB_LIB")"
# shellcheck source=lib/workspace-vm-commit.sh
source "$LIB_DIR/workspace-vm-commit.sh"
# shellcheck source=lib/workspace-checks-steps.sh
source "$LIB_DIR/workspace-checks-steps.sh"

ROOT="${WORKSPACE_CHECKS_DIR:-$HOME/.cache/layero-workspace/checks}"
DIR="$ROOT/cloud-cli"
export PATH="${HOME}/.local/lib/layero-node/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"

IFS=',' read -r -a WANT <<< "${WORKSPACE_CHECKS_STEPS:-}"
QUICK=0
if [ "${WANT[*]:-}" = quick ]; then
  QUICK=1
  WANT=()
else
  for s in ${WANT[@]+"${WANT[@]}"}; do
    check_in_list "$s" "${CHECK_STEPS[@]}" "${CHECK_EXTRA_STEPS[@]}" ||
      { echo "WORKSPACE_CHECKS_STEPS: unknown step $s (steps: ${CHECK_STEPS[*]} ${CHECK_EXTRA_STEPS[*]}, or quick)" >&2; exit 2; }
  done
fi
BASE="${WORKSPACE_CHECKS_BASE:-}"
[ -z "$BASE" ] || [[ "$BASE" =~ ^[0-9a-f]{40}$ ]] || { echo "WORKSPACE_CHECKS_BASE must be a 40-hex commit" >&2; exit 2; }
PARTIAL=0
{ [ "${#WANT[@]}" -gt 0 ] || [ "$QUICK" = 1 ]; } && PARTIAL=1

vm_commit_lock "$ROOT" checks
vm_commit_checkout "$DIR" "${WORKSPACE_CHECKS_REF:-}" "${WORKSPACE_CHECKS_SHA:-}"
cd "$DIR"
if [ "$QUICK" = 1 ]; then
  if [ -n "$BASE" ] && git cat-file -e "$BASE^{commit}" 2>/dev/null; then
    # The *-changed steps read CHECK_BASE in this shell; quick_check_steps runs in a subshell.
    export CHECK_BASE="$BASE"
    read -r -a WANT <<< "$(quick_check_steps "$BASE")"
    echo "quick run: changes since ${BASE:0:12} — $(git diff --name-only "$BASE" HEAD | wc -l | tr -d ' ') files; steps: ${WANT[*]}"
  else
    echo "quick run without a usable base commit: lint, typecheck and all tests"
    WANT=(shell lint typecheck test-server test-client)
  fi
fi
echo "workspace-run-checks owner=$JOB_OWNER ref=$VM_REF commit=$(git rev-parse --short HEAD) steps=${WORKSPACE_CHECKS_STEPS:-all}"
git log -1 --format='%h %an: %s'

status() { [ "$PARTIAL" = 1 ] || post_check_status "$VM_SHA" "$@"; }
status pending "running on $JOB_OWNER's Mac"
# A run that dies before the summary (npm ci, a lost VM) must not leave GitHub at "pending".
FINISHED=0
trap 'rmdir "$VM_COMMIT_LOCK"; [ "$FINISHED" = 1 ] || status error "checks aborted before the summary"' EXIT

vm_commit_npm_ci "$DIR"
export PATH="$DIR/node_modules/.bin:$PATH"

run_check_steps ${WANT[@]+"${WANT[@]}"}
FINISHED=1
print_check_summary "$(git rev-parse --short HEAD) ($VM_REF)"

if [ "$CHECK_FAILED" -eq 0 ]; then
  status success "${#CHECK_RESULTS[@]} steps passed"
  if [ "${WORKSPACE_CHECKS_THEN_STAGE:-0}" = 1 ]; then
    if [ "$PARTIAL" = 1 ]; then
      echo "then-stage skipped: only a full green run puts a branch on the stage"
      exit 0
    fi
    # The stage job takes its own lock and clone; release ours first.
    rmdir "$VM_COMMIT_LOCK" 2>/dev/null || true
    trap - EXIT
    echo ""
    echo "==> then-stage: $VM_REF @ ${VM_SHA:0:12}"
    export WORKSPACE_STAGE_REF="$VM_REF" WORKSPACE_STAGE_SHA="$VM_SHA"
    exec "$(dirname "$0")/workspace-run-stage"
  fi
  exit 0
fi
status failure "$CHECK_FAILED of ${#CHECK_RESULTS[@]} steps failed"
exit 1
